{
  "name": "arken-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c red,blue \"pnpm --filter @arken/server dev\" \"pnpm --filter @arken/web dev\"",
    "dev:db": "docker compose up -d postgres",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tests/e2e/tsconfig.json && tsc -p tsconfig.configs.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:multiplayer": "node scripts/run-multiplayer-e2e.mjs",
    "restore:rehearse": "node scripts/run-restore-rehearsal.mjs",
    "gameplay:reset:safe": "node scripts/run-gameplay-reset-safe.mjs",
    "incident:bundle": "node scripts/collect-incident-bundle.mjs",
    "db:generate": "pnpm --filter @arken/db generate",
    "db:migrate": "pnpm --filter @arken/db migrate",
    "db:studio": "pnpm --filter @arken/db studio",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/js": "10.0.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "concurrently": "10.0.4",
    "drizzle-orm": "^0.45.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-storybook": "^10.5.10",
    "fastify": "5.12.0",
    "prettier": "3.9.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "typescript": "5.9.3",
      "find-my-way": ">=9.7.0",
      "socket.io-parser": ">=4.2.7",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=4.1.2",
      "brace-expansion": ">=5.0.9"
    }
  }
}
