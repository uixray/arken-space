NODE_ENV=development
APP_VERSION=0.2.0-dev
BUILD_REVISION=development
# Optional loopback control plane; accepted only with LOCAL_HOST. Separate activation.
LOCAL_SESSION_BRIDGE_ENABLED=false
SCHEMA_VERSION=2
PORT=4100
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
POSTGRES_PASSWORD=arken
DATABASE_URL=postgres://arken:arken@localhost:5432/arken
SESSION_COOKIE_NAME=arken_session
SESSION_TTL_DAYS=30
GM_ACCESS_TOKEN=replace-with-at-least-32-random-characters
MEDIA_ROOT=./media
MEDIA_HOST_PATH=./media
MEDIA_QUOTA_BYTES=5368709120
MIN_FREE_DISK_BYTES=5368709120
MAX_IMAGE_BYTES=20971520
MAX_AUDIO_BYTES=104857600

# Telegram campaign bot: explicit separate activation, hosted test bot first.
# Reuse the existing approved bug receiver/chat and private BUG_INTAKE_ROOT.
TELEGRAM_CAMPAIGN_ENABLED=false
TELEGRAM_CAMPAIGN_RECEIVER_ID=
TELEGRAM_CAMPAIGN_USERNAME=
TELEGRAM_CAMPAIGN_TOKEN=
TELEGRAM_CAMPAIGN_SECRET=
TELEGRAM_CAMPAIGN_BUG_CHAT_ID=

# UIX-407: blank disables local persistence. Production uses infra/compose.performance.yml.
PERFORMANCE_LOG_DIR=
# Absolute dedicated host directory, never inside a release checkout.
PERFORMANCE_LOG_HOST_PATH=/opt/arken-space/telemetry
PERFORMANCE_MIN_FREE_DISK_BYTES=3221225472

# Optional personal dice naming; comma-separated membership UUIDs, empty preserves defaults.
GEOMETRIC_DICE_MEMBERSHIP_IDS=
# Optional stable account UUIDs for the same setting across that account's campaigns.
GEOMETRIC_DICE_USER_IDS=


# Preview: encrypted campaign export from the account workspace (HOSTED account auth; production HTTPS).
# Enable for qualification together with the matching import/release plan.
CAMPAIGN_TRANSFER_ENABLED=false

# Preview: owner-only campaign file upload into a LOCAL_HOST installation.
CAMPAIGN_TRANSFER_IMPORT_ENABLED=false
