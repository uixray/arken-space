NODE_ENV=development
APP_VERSION=0.2.0-dev
BUILD_REVISION=development
SCHEMA_VERSION=2
PORT=4100
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
POSTGRES_PASSWORD=arken
DATABASE_URL=postgres://arken:arken@localhost:5432/arken
SESSION_COOKIE_NAME=arken_session
SESSION_TTL_DAYS=30
GM_ACCESS_TOKEN=replace-with-at-least-32-random-characters
MEDIA_ROOT=./media
MEDIA_HOST_PATH=./media
MEDIA_QUOTA_BYTES=5368709120
MIN_FREE_DISK_BYTES=5368709120
MAX_IMAGE_BYTES=20971520
MAX_AUDIO_BYTES=104857600

# UIX-407: blank disables local persistence. Production uses infra/compose.performance.yml.
PERFORMANCE_LOG_DIR=
# Absolute dedicated host directory, never inside a release checkout.
PERFORMANCE_LOG_HOST_PATH=/opt/arken-space/telemetry
PERFORMANCE_MIN_FREE_DISK_BYTES=3221225472

# Optional personal dice naming; comma-separated membership UUIDs, empty preserves defaults.
GEOMETRIC_DICE_MEMBERSHIP_IDS=

